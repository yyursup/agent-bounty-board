# Chain the app talks to: 56 = BNB Chain mainnet, 97 = BSC testnet.
NEXT_PUBLIC_CHAIN_ID=97

# Deployed BountyBoard and its reward token (USDC). Printed by the deploy scripts in /contracts.
NEXT_PUBLIC_BOUNTY_BOARD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Optional RPC override. Defaults to the public endpoint of the chain.
NEXT_PUBLIC_RPC_URL=

# Gateway used to read briefs and attachments.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Server only: Pinata JWT used by /api/pin to pin briefs and attachments. Never expose it to the client.
PINATA_JWT=
